# ---- Stage 1: Build React app ----
FROM node:18-alpine AS builder

WORKDIR /app/frontend

# Allow bigger heap for webpack on small VPS
ENV NODE_OPTIONS=--max-old-space-size=2048

# Copy package files — yarn.lock is optional but preferred for reproducibility
COPY frontend/package.json ./
# Copy yarn.lock only if it exists (glob makes it optional)
COPY frontend/package.json frontend/yarn.loc[k] ./

# Install dependencies
RUN yarn install --network-timeout 300000

# Copy full source
COPY frontend/ .

# REACT_APP_BACKEND_URL="" means use relative path → Nginx proxies /api
ARG REACT_APP_BACKEND_URL=""
ENV REACT_APP_BACKEND_URL=${REACT_APP_BACKEND_URL}

RUN yarn build

# ---- Stage 2: Serve with Nginx ----
FROM nginx:alpine

COPY --from=builder /app/frontend/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

# ---- Stage 1: Build React app ----
FROM node:18-alpine AS builder

WORKDIR /app/frontend

# Allow bigger heap for webpack on small VPS
ENV NODE_OPTIONS=--max-old-space-size=2048

# Copy package files — yarn.lock optional but preferred for reproducibility
COPY frontend/package.json ./
# yarn.loc[k] glob makes yarn.lock optional if not committed yet
COPY frontend/package.json frontend/yarn.loc[k] ./

RUN yarn install --network-timeout 300000

COPY frontend/ .

# REACT_APP_BACKEND_URL="" → relative /api path → Caddy proxies it to backend
ARG REACT_APP_BACKEND_URL=""
ENV REACT_APP_BACKEND_URL=${REACT_APP_BACKEND_URL}

RUN yarn build

# ---- Stage 2: Serve with Caddy ----
FROM caddy:2-alpine

# Built React SPA goes to /srv (matches Caddyfile)
COPY --from=builder /app/frontend/build /srv

# Use the existing Caddyfile from repo root
COPY Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]


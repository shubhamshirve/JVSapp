# syntax=docker/dockerfile:1
# ---- Stage 1: Build React app ----
FROM node:20-alpine AS builder

WORKDIR /app/frontend

# Allow bigger heap for webpack on small VPS
ENV NODE_OPTIONS=--max-old-space-size=1536
# Skip ESLint during production build (saves ~30s)
ENV DISABLE_ESLINT_PLUGIN=true
# Avoid interactive prompts
ENV CI=false

# Copy package.json first (always exists)
COPY frontend/package.json ./

# Install dependencies
# - BuildKit bind mount gives access to yarn.lock from build context (if committed)
# - BuildKit cache mount keeps yarn download cache between builds
# - Falls back to --no-frozen-lockfile if yarn.lock is missing from git
RUN --mount=type=bind,source=frontend,target=/build-ctx \
    --mount=type=cache,target=/root/.yarn \
    if [ -f /build-ctx/yarn.lock ]; then \
        cp /build-ctx/yarn.lock . && \
        echo "yarn.lock found - reproducible install" && \
        YARN_CACHE_FOLDER=/root/.yarn yarn install --frozen-lockfile --network-timeout 600000 --prefer-offline; \
    else \
        echo "WARNING: yarn.lock not in repo - run 'git add frontend/yarn.lock && git commit' for reproducible builds" && \
        YARN_CACHE_FOLDER=/root/.yarn yarn install --no-frozen-lockfile --network-timeout 600000 --prefer-offline; \
    fi

# Copy full source
COPY frontend/ .

# REACT_APP_BACKEND_URL="" -> relative /api paths -> Caddy proxies to backend
ARG REACT_APP_BACKEND_URL=""
ENV REACT_APP_BACKEND_URL=${REACT_APP_BACKEND_URL}

RUN yarn build

# ---- Stage 2: Serve with Caddy ----
FROM caddy:2-alpine

COPY --from=builder /app/frontend/build /srv
COPY Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]

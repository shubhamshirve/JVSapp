# ---- Stage 1: Build React app ----
FROM node:20-alpine AS builder

WORKDIR /app/frontend

# Allow bigger heap for webpack on small VPS
ENV NODE_OPTIONS=--max-old-space-size=1536

# Install pnpm globally
RUN npm install -g pnpm

# Disable corepack strict mode so pnpm works even though package.json declares yarn
ENV COREPACK_ENABLE_STRICT=0

# Copy package.json first (cache layer — only re-runs if deps change)
COPY frontend/package.json ./

# Install dependencies
RUN pnpm install --no-frozen-lockfile

# Copy full source
COPY frontend/ .

# REACT_APP_BACKEND_URL="" → relative /api path → Caddy proxies to backend
ARG REACT_APP_BACKEND_URL=""
ENV REACT_APP_BACKEND_URL=${REACT_APP_BACKEND_URL}
# Skip ESLint during production build (avoids version conflicts with pnpm-resolved deps)
ENV DISABLE_ESLINT_PLUGIN=true

RUN pnpm run build

# ---- Stage 2: Serve with Caddy ----
FROM caddy:2-alpine

COPY --from=builder /app/frontend/build /srv
COPY Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]


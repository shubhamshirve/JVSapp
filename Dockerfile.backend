# ---- Backend image: FastAPI (uvicorn) ----
FROM python:3.11-slim

WORKDIR /app/backend

# System deps (bcrypt build etc.)
RUN apt-get update && apt-get install -y --no-install-recommends gcc && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
# extra-index-url covers the internal emergentintegrations package listed in requirements.txt
RUN pip install --no-cache-dir --extra-index-url https://d33sy5i8bnduwe.cloudfront.net/simple/ -r requirements.txt

COPY backend/ .

EXPOSE 8001

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001"]

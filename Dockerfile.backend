# ---- Jivdani Backend ----
FROM python:3.11-slim

WORKDIR /app/backend

# Install dependencies first (layer caching)
COPY backend/requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

# Copy source
COPY backend/ .

EXPOSE 8001

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
